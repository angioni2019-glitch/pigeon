# --- Required -------------------------------------------------------------
# Your own Telegram API credentials from https://my.telegram.org > API development tools.
TG_API_ID=
TG_API_HASH=

# Public HTTPS address of this bridge (also used by docker-compose/Caddy).
BRIDGE_DOMAIN=tg.example.com
PUBLIC_URL=https://tg.example.com

# --- Optional -------------------------------------------------------------
# Only these Telegram user ids may link (comma separated). Leave empty to allow anyone.
ALLOWED_USER_IDS=
# If set, the watch must send the same key (app setting "Pairing key") to start linking.
PAIRING_KEY=
MAX_SESSIONS=50
# Close a watch's Telegram client after this many idle minutes (it reopens on the next request).
IDLE_CLOSE_MIN=20
VOICE_MAX_SECONDS=180
LOG_LEVEL=info

# Run without Telegram, with fake chats, for trying the watch app in the simulator.
DEMO=0
DEMO_2FA=0
